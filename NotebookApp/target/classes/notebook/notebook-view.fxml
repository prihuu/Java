<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER"
      prefHeight="700.0"
      prefWidth="600.0"
      spacing="10.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.notebook.NoteController">

   <children>

      <Label text="My Notebook">
         <font>
            <Font size="28.0"/>
         </font>
      </Label>

      <TextField fx:id="titleField"
                 promptText="Enter note title..."/>

      <TextArea fx:id="contentArea"
                prefRowCount="6"
                promptText="Write your note here..."/>

      <Button fx:id="addButton"
              mnemonicParsing="false"
              onAction="#addNote"
              text="Add Note"/>

      <Label text="Saved Notes">
         <font>
            <Font size="20.0"/>
         </font>
      </Label>

      <VBox fx:id="notesContainer"
            prefWidth="500.0"
            spacing="10.0"/>

   </children>
</VBox>
